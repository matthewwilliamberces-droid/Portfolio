---
// Contact Section — Brutalist, oversized typography, no cards
---

<section id="contact" class="py-32 border-t border-[var(--border-subtle)] bg-[var(--bg-canvas)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">

      <!-- Left: Massive copy -->
      <div class="lg:col-span-8 enter">
        <p class="text-xs font-mono uppercase tracking-widest text-[var(--ink-subtle)] mb-8">Initiate Project</p>
        
        <h2 class="text-[clamp(3rem,6vw,5.5rem)] leading-[0.9] tracking-tighter text-[var(--ink-primary)] font-serif italic mb-8">
          Let's build <br />
          <span class="font-sans not-italic font-extrabold tracking-tight">something real.</span>
        </h2>
        
        <p class="text-xl text-[var(--ink-muted)] leading-relaxed max-w-[45ch]">
          Looking for a Laravel engineer to build your SaaS platform, admin panel, or robust web application? I take on freelance projects with strict requirements and serious deadlines.
        </p>

        <ul class="mt-12 space-y-4 font-mono text-sm text-[var(--ink-muted)]">
          {[
            "SaaS platforms with multi-tenancy and billing",
            "Admin dashboards with Filament v3",
            "Laravel APIs and Livewire apps",
            "Legacy PHP modernization",
          ].map((item) => (
            <li class="flex items-center gap-4">
              <span class="w-4 h-[1px] bg-[var(--border-subtle)]"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: Raw CTA (No card, just pure interaction) -->
      <div class="lg:col-span-4 enter enter-d2 flex flex-col justify-end h-full">
        <div class="pt-12 lg:pt-0 lg:border-l lg:border-[var(--border-subtle)] lg:pl-12">
          
          <p class="text-xs font-mono text-[var(--ink-subtle)] uppercase tracking-widest mb-6">Connect</p>

          <a
            href="https://www.fiverr.com/matthewberces?public_mode=true"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative inline-flex items-center justify-between w-full p-6 bg-[var(--ink-primary)] text-[var(--bg-canvas)] hover:bg-[var(--accent)] transition-colors"
          >
            <span class="text-lg font-bold tracking-tight">Fiverr Profile</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>

          <div class="my-8 border-t border-[var(--border-subtle)]"></div>

          <a
            href="https://github.com/matthewwilliamberces-droid"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 text-sm font-mono text-[var(--ink-muted)] hover:text-[var(--ink-primary)] transition-colors"
          >
            <span>github.com/matthewwilliamberces-droid</span>
            <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>

          <p class="mt-12 text-[10px] font-mono text-[var(--ink-subtle)] leading-relaxed uppercase tracking-widest">
            Availability: Accepting Offers<br />
            Stack: Laravel, Livewire, Filament
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
