---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} | Matthew`}
  description={project.data.description}
>
  <article class="py-12 max-w-4xl mx-auto">
    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-[var(--ink-muted)] hover:text-[var(--accent-text)] transition-colors mb-8"
    >
      &larr; Back to all projects
    </a>

    <!-- Header Metadata -->
    <header class="border-b border-[var(--border-subtle)] pb-8 mb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-[var(--ink-subtle)] mb-3">
        <span>{project.data.role}</span>
        <span>&bull;</span>
        <time datetime={project.data.publishDate.toISOString()}>
          {project.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--ink-primary)] tracking-tight">
        {project.data.title}
      </h1>

      <p class="mt-4 text-lg text-[var(--ink-muted)] leading-relaxed">
        {project.data.description}
      </p>

      {project.data.impact && (
        <div class="mt-6 border-l-2 border-[var(--accent-border)] pl-4 py-1 text-sm text-[var(--accent-text)] leading-relaxed">
          <strong class="font-bold">Production Impact:</strong> {project.data.impact}
        </div>
      )}

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-1.5">
          {project.data.tags.map((tag) => (
            <span class="px-2.5 py-1 rounded text-xs font-mono text-[var(--accent-text)] bg-[var(--accent-dim)] border border-[var(--accent-border)]">
              {tag}
            </span>
          ))}
        </div>

        <div class="flex items-center gap-3">
          {project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-subtle)] hover:bg-[var(--bg-raised)] text-xs font-semibold text-[var(--ink-primary)] transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              Repository
            </a>
          )}
          {project.data.isPrivate && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-subtle)] text-xs font-mono text-[var(--ink-muted)] bg-[var(--bg-raised)]">
              <svg class="w-3.5 h-3.5 text-[var(--ink-subtle)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              Private Repository
            </span>
          )}
          {project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-white text-xs font-semibold shadow-sm transition-colors"
            >
              Live Service
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Markdown Content Body -->
    <div class="prose dark:prose-invert max-w-none prose-headings:font-bold prose-headings:text-[var(--ink-primary)] prose-p:text-[var(--ink-muted)] prose-a:text-[var(--accent-text)] prose-pre:border prose-pre:border-[var(--border-subtle)] prose-pre:rounded-xl">
      <Content />
    </div>

    <!-- Article Footer / Navigation -->
    <footer class="mt-12 pt-8 border-t border-[var(--border-subtle)] flex justify-between items-center">
      <a
        href="/projects"
        class="text-sm font-semibold text-[var(--accent-text)] hover:underline inline-flex items-center gap-1"
      >
        &larr; Back to all projects
      </a>
      <a
        href="#top"
        class="text-xs text-[var(--ink-subtle)] hover:text-[var(--ink-primary)] transition-colors font-mono"
      >
        Back to top &uarr;
      </a>
    </footer>
  </article>
</BaseLayout>
