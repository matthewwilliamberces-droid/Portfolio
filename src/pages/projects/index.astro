---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});

const allTags = Array.from(new Set(projects.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout
  title="All Projects & Systems Architecture | Matthew"
  description="Comprehensive archive of web applications, SaaS platforms, and software engineering projects."
>
  <div class="py-12 sm:py-16">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-[var(--ink-muted)] hover:text-[var(--accent-text)] transition-colors mb-6"
    >
      &larr; Back to Home
    </a>

    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--ink-primary)] tracking-tight">
        Engineered Systems &amp; Case Studies
      </h1>
      <p class="mt-3 text-base text-[var(--ink-muted)] max-w-2xl">
        In-depth technical architecture, benchmarks, and engineering decisions for SaaS platforms and web applications.
      </p>
    </div>

    <!-- Tag Filter Badges -->
    <div class="flex flex-wrap gap-2 mb-10 pb-6 border-b border-[var(--border-subtle)]">
      <span class="text-xs font-mono font-medium text-[var(--ink-subtle)] self-center mr-1">Filter:</span>
      <button
        type="button"
        class="tag-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium bg-[var(--accent)] text-white transition-colors cursor-pointer"
        data-tag="all"
      >
        All ({sortedProjects.length})
      </button>
      {allTags.map((tag) => {
        const count = sortedProjects.filter((p) => p.data.tags.includes(tag)).length;
        return (
          <button
            type="button"
            class="tag-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium glass text-[var(--ink-muted)] hover:text-[var(--ink-primary)] hover:bg-[var(--bg-raised)] transition-colors cursor-pointer"
            data-tag={tag}
          >
            {tag} ({count})
          </button>
        );
      })}
    </div>

    <!-- Projects Grid -->
    <div id="projects-list" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedProjects.map((project) => (
        <article
          class="project-item glass flex flex-col rounded-xl p-6 hover:bg-[var(--bg-raised)] transition-all group"
          data-tags={JSON.stringify(project.data.tags)}
        >
          <div class="flex items-center justify-between text-xs font-mono text-[var(--ink-subtle)] mb-2">
            <span>{project.data.role}</span>
            <time datetime={project.data.publishDate.toISOString()}>
              {project.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </time>
          </div>

          <h2 class="text-xl font-bold text-[var(--ink-primary)] group-hover:text-[var(--accent-text)] transition-colors">
            <a href={`/projects/${project.id}`}>
              {project.data.title}
            </a>
          </h2>

          <p class="mt-2.5 text-sm text-[var(--ink-muted)] flex-grow leading-relaxed">
            {project.data.description}
          </p>

          {project.data.impact && (
            <div class="mt-4 border-l-2 border-[var(--accent-border)] pl-3 text-xs text-[var(--accent-text)] leading-relaxed">
              <strong class="font-semibold">Outcome:</strong> {project.data.impact}
            </div>
          )}

          <div class="mt-4 pt-4 border-t border-[var(--border-subtle)] flex flex-wrap gap-1.5">
            {project.data.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded text-xs font-mono text-[var(--accent-text)] bg-[var(--accent-dim)] border border-[var(--accent-border)]">
                {tag}
              </span>
            ))}
          </div>

          <div class="mt-4 flex items-center justify-between pt-2">
            <a
              href={`/projects/${project.id}`}
              class="text-xs font-semibold text-[var(--ink-muted)] hover:text-[var(--ink-primary)] inline-flex items-center gap-1"
            >
              Read Architecture &rarr;
            </a>
            <div class="flex items-center gap-3">
              {project.data.githubUrl && (
                <a
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--ink-subtle)] hover:text-[var(--ink-primary)] transition-colors"
                  aria-label={`${project.data.title} Source Code`}
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                </a>
              )}
              {project.data.isPrivate && (
                <span class="inline-flex items-center gap-1 text-[11px] font-mono text-[var(--ink-subtle)]" title="Private Commercial Codebase">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                  Private
                </span>
              )}
              {project.data.liveUrl && (
                <a
                  href={project.data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--ink-subtle)] hover:text-[var(--accent)] transition-colors"
                  aria-label={`${project.data.title} Live URL`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const initFilters = () => {
    const buttons = document.querySelectorAll('.tag-filter-btn');
    const items = document.querySelectorAll('.project-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedTag = btn.getAttribute('data-tag');

        buttons.forEach((b) => {
          b.classList.remove('bg-[var(--accent)]', 'text-white');
          b.classList.add('glass', 'text-[var(--ink-muted)]');
        });
        btn.classList.add('bg-[var(--accent)]', 'text-white');
        btn.classList.remove('glass', 'text-[var(--ink-muted)]');

        items.forEach((item) => {
          const itemTags = JSON.parse(item.getAttribute('data-tags') || '[]');
          if (selectedTag === 'all' || itemTags.includes(selectedTag)) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  };

  initFilters();
  document.addEventListener('astro:after-swap', initFilters);
</script>
