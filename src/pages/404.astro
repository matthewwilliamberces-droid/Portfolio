---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404: Route Not Found | Matthew P."
  description="The requested route does not exist."
>
  <div class="py-20 sm:py-32 flex flex-col items-center justify-center text-center">
    <span class="text-xs font-mono font-bold tracking-widest text-blue-600 dark:text-blue-400 uppercase">
      Error 404
    </span>
    <h1 class="mt-2 text-4xl sm:text-5xl font-extrabold text-neutral-900 dark:text-white tracking-tight">
      Route not found
    </h1>
    <p class="mt-4 text-base text-neutral-600 dark:text-neutral-400 max-w-md">
      The route you attempted to access does not exist or has been relocated to another endpoint.
    </p>

    <div class="mt-8 flex items-center gap-3">
      <a
        href="/"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm shadow-sm transition-colors"
      >
        Return to Home
      </a>
      <a
        href="/projects"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200 font-medium text-sm transition-colors"
      >
        Browse Projects
      </a>
    </div>
  </div>
</BaseLayout>
